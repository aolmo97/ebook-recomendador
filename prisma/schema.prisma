// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Source {
  GUTENBERG
  STANDARD_EBOOKS
}

model User {
  id        String   @id @default(cuid())
  email     String?  @unique
  createdAt DateTime @default(now())

  likes Like[]
}

model Book {
  id        String   @id @default(cuid())
  source    Source
  sourceId  String
  title     String
  author    String
  coverUrl  String?
  language  String
  genres    String[]
  synopsis  String?
  urlEpub   String
  createdAt DateTime @default(now())

  likes Like[]

  @@unique([source, sourceId])
}

model Like {
  id        String   @id @default(cuid())
  userId    String
  bookId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
}

// Cache de metadata (no imágenes) de series/capítulos de manga, para no
// rescrapear la fuente en cada consulta de detalle. Ver src/lib/manga/README.md.
model MangaSeries {
  id         String   @id // id estable del adaptador (slug/uuid de la fuente)
  title      String
  synopsis   String?
  coverUrl   String?
  sourceUrl  String
  updatedAt  DateTime @updatedAt

  chapters MangaChapter[]
}

model MangaChapter {
  id          String    @id @default(cuid())
  seriesId    String
  chapterId   String // id estable del capítulo en la fuente
  number      String
  title       String?
  publishedAt DateTime?
  updatedAt   DateTime  @updatedAt

  series MangaSeries @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@unique([seriesId, chapterId])
}
